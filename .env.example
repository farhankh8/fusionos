# =============================================================================
# FusionOS Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# ── Database (Phase 2+) ──────────────────────────────────────────────────────
# DATABASE_URL=postgresql://fusionos:fusionos@localhost:5432/fusionos?schema=public

# ── Redis (Phase 2+) ────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Authentication (Phase 3) ───────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Provider (Phase 17) ──────────────────────────────────────────────────
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
# AI_API_KEY=your-ai-api-key
# AI_TIMEOUT=30000

# ── Storage (Phase 14+) ─────────────────────────────────────────────────────
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=fusionos
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ── Email (Phase 26) ───────────────────────────────────────────────────────
# Provider: console (development), http (production)
# In development, emails are logged to the console.
# In production, configure an HTTP-based email API (Resend, SendGrid, etc.).
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=http          # Uncomment for production
# EMAIL_API_KEY=               # Your email API key (required for http provider)
# EMAIL_API_URL=               # API endpoint URL (required for http provider)
# EMAIL_FROM=noreply@fusionos.dev  # Sender address (required for http provider)
# EMAIL_PROVIDER_NAME=http     # Optional: provider name for logging
# EMAIL_TIMEOUT=10000          # Optional: request timeout in ms

# ── Security ─────────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# ── MCP Integrations ─────────────────────────────────────────────────────
# 21st MCP — Get your key at https://21st.dev/mcp
# API_KEY_21ST=your-21st-api-key
