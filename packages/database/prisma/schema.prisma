  @@index([assetId])
  @@index([createdAt])
  @@index([tenantId, assetId])
  @@map("asset_activities")
}

// =============================================================================
// SCHEMA NOTES
// =============================================================================
//
// 1. SOFT DELETE STRATEGY:
//    - Employee: soft-deleted (deletedAt) — employment records have legal significance
//    - Audit logs: NEVER deleted (append-only)
//    - Financial records: NEVER deleted (immutable)
//    - User accounts: status-based (ACTIVE/INACTIVE/LOCKED) — not soft-deleted
//    - Most other entities: hard-deleted with CASCADE where appropriate
//
// 2. MONEY STRATEGY:
//    - All monetary amounts use INTEGER minor units (e.g., cents)
//    - Currency stored as ISO 4217 3-letter code
//    - Example: AED 1,250.50 → amount: 125050, currency: "AED"
//    - Float fields are PROHIBITED for financial data
//    - Rounding rules documented per business domain
//
// 3. INDEXING STRATEGY:
//    - Every tenant-scoped table has tenantId index
//    - Composite indexes for common query patterns (tenantId + status, tenantId + date)
//    - Foreign key columns indexed for join performance
//    - Unique constraints enforce business rules at DB level
//
// 4. CONCURRENCY STRATEGY:
//    - updatedAt-based optimistic concurrency (checked at application level)
//    - Version fields added where concurrent editing is likely (Phase 9+)
//
// 5. IDEMPOTENCY (Phase 17+):
//    - EventOutbox supports idempotent event publication
//    - Future: attendance sync, payments, webhooks, automation actions
//    - Idempotency keys will be added to relevant tables in their respective phases
//
// 6. FUTURE EXPANSION:
//    - Phase 3: extends User with auth fields (passwordHash, mfaSecret, etc.)
//    - Phase 7: adds Attendance, Shift, Holiday models
//    - Phase 8: adds LeaveType, LeaveBalance, LeaveRequest models
//    - Phase 9: adds PayrollPeriod, PayrollRecord, SalaryComponent models
//    - Phase 10: adds Account, JournalEntry, JournalLine, Invoice models
//    - Phase 11-13: adds CRM, Project, Asset models
//    - Phase 14: adds Notification, Message models
//    - Phase 17: EventOutbox dispatcher (this table already exists)
//    - Phase 24: adds AuditLog model (append-only)
//
// =============================================================================
// =============================================================================
// PHASE 9 — FINANCE & ACCOUNTING
// =============================================================================
// Double-entry accounting foundation. Every posted transaction satisfies
// TOTAL DEBITS = TOTAL CREDITS. The accounting ledger is authoritative.
// =============================================================================

// ── Finance Enums ─────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountSubtype {
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  PAYROLL_PAYABLE
  TAX_PAYABLE
  FIXED_ASSET
  INVENTORY
  REVENUE
  OPERATING_EXPENSE
  OTHER
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSING
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REVERSED
  VOIDED
}

enum JournalEntryType {
  STANDARD
  PAYROLL
  EXPENSE
  PAYMENT
  ADJUSTMENT
  REVERSAL
  OPENING_BALANCE
}

enum SourceDocumentType {
  MANUAL_JOURNAL
  PAYROLL_RUN
  PAYROLL_LINE
  PAYSLIP
  EXPENSE
  INVOICE
  BILL
  PAYMENT
  BANK_ADJUSTMENT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  PAID
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VOID
}

enum BankReconciliationStatus {
  UNMATCHED
  MATCHED
  RECONCILED
}

// ── Chart of Accounts ─────────────────────────────────────────────────────

model Account {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  companyId         String           @db.Uuid
  parentId          String?          @db.Uuid
  code              String           @db.VarChar(20)
  name              String           @db.VarChar(255)
  description       String?          @db.Text
  accountType       AccountType
  accountSubtype    AccountSubtype?  @default(OTHER)
  normalBalance     NormalBalance
  currency          String           @default("USD") @db.VarChar(3)
  isActive          Boolean          @default(true)
  isSystemAccount   Boolean          @default(false)
  allowManualPosting Boolean         @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent            Account?         @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]        @relation("AccountHierarchy")
  journalLines      JournalLine[]
  accountBalances   AccountBalance[]
  bankAccounts      BankAccount[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([parentId])
  @@index([accountType])
  @@index([tenantId, companyId, accountType])
  @@map("accounts")
}

/// AccountBalance stores denormalized balance projections for performance.
/// These are REBUILDABLE from JournalLine — never the sole source of truth.
model AccountBalance {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  companyId         String    @db.Uuid
  accountId         String    @db.Uuid
  periodId          String    @db.Uuid
  openingDebit      Int       @default(0)
  openingCredit     Int       @default(0)
  periodDebit       Int       @default(0)
  periodCredit      Int       @default(0)
  closingDebit      Int       @default(0)
  closingCredit     Int       @default(0)
  currency          String    @default("USD") @db.VarChar(3)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  period            AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, accountId, periodId])
  @@index([tenantId])
  @@index([companyId])
  @@index([accountId])
  @@index([periodId])
  @@map("account_balances")
}

// ── Fiscal / Accounting Periods ───────────────────────────────────────────

model AccountingPeriod {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @db.Uuid
  companyId         String                 @db.Uuid
  name              String                 @db.VarChar(100)
  startDate         DateTime               @db.Date
  endDate           DateTime               @db.Date
  status            AccountingPeriodStatus @default(OPEN)
  isFiscalYearEnd   Boolean                @default(false)
  closedBy          String?                @db.Uuid
  closedAt          DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries    JournalEntry[]
  accountBalances   AccountBalance[]

  @@unique([tenantId, companyId, startDate])
  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, companyId, status])
  @@map("accounting_periods")
}

// ── Journal Entries ───────────────────────────────────────────────────────

model JournalEntry {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  companyId         String            @db.Uuid
  journalNumber     String            @db.VarChar(50)
  postingDate       DateTime          @db.Date
  documentDate      DateTime          @db.Date
  entryType         JournalEntryType  @default(STANDARD)
  referenceType     SourceDocumentType?
  referenceId       String?           @db.Uuid
  description       String            @db.VarChar(500)
  status            JournalEntryStatus @default(DRAFT)
  currency          String            @default("USD") @db.VarChar(3)
  totalDebit        Int               @default(0)
  totalCredit       Int               @default(0)
  periodId          String?           @db.Uuid
  reversalOf        String?           @db.Uuid
  reversedBy        String?           @db.Uuid
  createdBy         String            @db.Uuid
  approvedBy        String?           @db.Uuid
  postedBy          String?           @db.Uuid
  postedAt          DateTime?
  voidedBy          String?           @db.Uuid
  voidedAt          DateTime?
  voidReason        String?           @db.VarChar(500)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period            AccountingPeriod? @relation(fields: [periodId], references: [id])
  lines             JournalLine[]
  originalEntry     JournalEntry?     @relation("JournalReversal", fields: [reversalOf], references: [id])
  reversedEntries   JournalEntry[]    @relation("JournalReversal")

  @@unique([tenantId, companyId, journalNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@index([postingDate])
  @@index([referenceType, referenceId])
  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, postingDate])
  @@index([periodId])
  @@map("journal_entries")
}

model JournalLine {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  companyId         String            @db.Uuid
  journalEntryId    String            @db.Uuid
  accountId         String            @db.Uuid
  lineNumber        Int
  description       String?           @db.VarChar(500)
  debit             Int               @default(0)
  credit            Int               @default(0)
  currency          String            @default("USD") @db.VarChar(3)
  employeeId        String?           @db.Uuid
  branchId          String?           @db.Uuid
  departmentId      String?           @db.Uuid
  reference         String?           @db.VarChar(255)
  createdAt         DateTime          @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry      JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([employeeId])
  @@index([tenantId, companyId, accountId])
  @@map("journal_lines")
}

// ── Expenses ──────────────────────────────────────────────────────────────

model Expense {
