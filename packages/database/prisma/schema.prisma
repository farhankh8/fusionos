// =============================================================================
// PLATFORM KERNEL
// =============================================================================
// These entities establish the core infrastructure that every module depends on.
// They are tenant-aware and form the foundation for identity, organization,
// and multi-tenancy.

/// Tenant represents an isolated business entity (a company/organization on the platform).
/// Every tenant-sensitive record references a tenantId.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(100)
  status    TenantStatus @default(ACTIVE)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  companies        Company[]
  userRoles        UserRole[]
  roles            Role[]
  employees        Employee[]
  payrollPolicies  PayrollPolicy[]
  payrollComponents PayrollComponent[]
  payrollPeriods   PayrollPeriod[]
  payrollRuns      PayrollRun[]
  // Phase 9 — Finance
  accounts         Account[]
  accountingPeriods AccountingPeriod[]
  journalEntries   JournalEntry[]
  journalLines     JournalLine[]
  accountBalances  AccountBalance[]
  expenses         Expense[]
  customers        Customer[]
  invoices         Invoice[]
  vendors          Vendor[]
  bills            Bill[]
  payments         Payment[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  // Phase 10 — CRM
  customerProfiles CustomerProfile[]
  crmContacts      Contact[]
  crmLeads         Lead[]
  crmOpportunities Opportunity[]
  crmActivities    Activity[]
  crmTasks         Task[]
  crmNotes         CrmNote[]
  // Phase 11 — Projects
  projects          Project[]
  // Phase 12 — Documents
  documentCategories DocumentCategory[]
  documentFolders   DocumentFolder[]
  documents         Document[]
  // Phase 13 — Notifications
  notifications              Notification[]
  notificationDeliveries     NotificationDelivery[]
  notificationPreferences    NotificationPreference[]
  notificationTemplates      NotificationTemplate[]
  notificationTemplateVersions NotificationTemplateVersion[]
  notificationChannelConfigs NotificationChannelConfiguration[]
  // Phase 14 — Assets
  assetCategories            AssetCategory[]
  assetLocations             AssetLocation[]
  assets                     Asset[]
  // Phase 15 — Analytics
  savedReports               SavedReport[]
  // Phase 16 — Automation
  automationWorkflows        AutomationWorkflow[]
  automationWorkflowVersions AutomationWorkflowVersion[]
  automationExecutions       AutomationExecution[]
  automationStepExecutions   AutomationStepExecution[]
  automationApprovals        AutomationApproval[]
  // Phase 17 — AI
  aiConversations            AIConversation[]
  aiRequestLogs              AIRequestLog[]
  // Phase 18 — AI Agents
  aiAgents                   AIAgent[]
  aiAgentVersions            AIAgentVersion[]
  aiAgentTasks               AIAgentTask[]
  aiAgentSteps               AIAgentStep[]
  aiAgentMemories            AIAgentMemory[]

  @@map("tenants")
}

// =============================================================================
// ORGANIZATION
// =============================================================================
// Company, Branch, Department, Team — the organizational hierarchy.
// These entities dimension every later business record.

/// Company is the primary organizational unit within a tenant.
/// A tenant may have one or more companies (for holding structures).
model Company {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  name        String       @db.VarChar(255)
  legalName   String?      @db.VarChar(500)
  code        String       @db.VarChar(50)
  status      CompanyStatus @default(ACTIVE)
  registrationNumber String? @db.VarChar(100)
  taxId       String?      @db.VarChar(100)
  email       String?      @db.VarChar(255)
  phone       String?      @db.VarChar(50)
  website     String?      @db.VarChar(500)
  logo        String?      @db.VarChar(500)
  address     Json?
  timezone    String?      @db.VarChar(100)
  currency    String?      @db.VarChar(3)  // ISO 4217
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches     Branch[]
  departments  Department[]
  teams        Team[]
  employees    Employee[]
  // Phase 9 — Finance
  accounts         Account[]
  accountingPeriods AccountingPeriod[]
  journalEntries   JournalEntry[]
  journalLines     JournalLine[]
  accountBalances  AccountBalance[]
  expenses         Expense[]
  customers        Customer[]
  invoices         Invoice[]
  vendors          Vendor[]
  bills            Bill[]
  payments         Payment[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  // Phase 10 — CRM
  customerProfiles CustomerProfile[]
  crmContacts      Contact[]
  crmLeads         Lead[]
  crmOpportunities Opportunity[]
  crmActivities    Activity[]
  crmTasks         Task[]
  crmNotes         CrmNote[]
  // Phase 11 — Projects
  projects          Project[]
  // Phase 12 — Documents
  documents         Document[]
  // Phase 14 — Assets
  assetCategories   AssetCategory[]
  assetLocations    AssetLocation[]
  assets            Asset[]
  // Phase 18 — AI Agents
  aiAgents          AIAgent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("companies")
}

/// Branch represents a physical location or office of a company.
model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  companyId   String       @db.Uuid
  name        String       @db.VarChar(255)
  code        String       @db.VarChar(50)
  status      BranchStatus @default(ACTIVE)
  address     Json?
  phone       String?      @db.VarChar(50)
  email       String?      @db.VarChar(255)
  timezone    String?      @db.VarChar(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments      Department[]
  employees        Employee[]
  projects         Project[]
  assetLocations   AssetLocation[]
  fromTransfers    AssetTransfer[] @relation("TransferFromBranch")
  toTransfers      AssetTransfer[] @relation("TransferToBranch")

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@map("branches")
}

/// Department represents a functional unit within a company.
model Department {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  companyId   String           @db.Uuid
  branchId    String?          @db.Uuid
  parentId    String?          @db.Uuid
  name        String           @db.VarChar(255)
  code        String           @db.VarChar(50)
  status      DepartmentStatus @default(ACTIVE)
  headId      String?          @db.Uuid  // Employee who heads this department
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  teams       Team[]
  employees   Employee[]
  projects    Project[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([parentId])
  @@map("departments")
}

/// Team represents a small group within a department.
model Team {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  companyId     String      @db.Uuid
  departmentId  String      @db.Uuid
  name          String      @db.VarChar(255)
  code          String      @db.VarChar(50)
  status        TeamStatus  @default(ACTIVE)
  managerId     String?     @db.Uuid  // Employee who manages this team
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([departmentId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([departmentId])
  @@map("teams")
}

// =============================================================================
// IDENTITY — USER, ROLE, PERMISSION
// =============================================================================
// The identity layer controls who can access what.
// Designed for Phase 3 (Auth) and Phase 4 (Multi-Tenancy) to extend cleanly.

/// User represents a platform-level identity (a person who can log in).
/// A user may belong to multiple tenants via UserRole.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @db.VarChar(255)
  firstName       String    @db.VarChar(255)
  lastName        String    @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)  // Argon2id hash — never exposed via API
  status          UserStatus @default(PENDING_VERIFICATION)
  isEmailVerified Boolean   @default(false)
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?   @db.VarChar(255)  // TOTP secret — encrypted at rest in production
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenants             UserRole[]
  employees           Employee[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthEvent[]
  // Phase 13 — Notifications
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  notificationTemplates      NotificationTemplate[]
  notificationTemplateVersions NotificationTemplateVersion[]
  // Phase 15 — Analytics
  savedReports               SavedReport[]
  // Phase 16 — Automation
  automationWorkflows        AutomationWorkflow[]
  automationPublishedVersions AutomationWorkflowVersion[]
  automationApprovalsRequested AutomationApproval[] @relation("ApprovalRequester")
  automationApprovalsToApprove AutomationApproval[] @relation("ApprovalApprover")
  // Phase 17 — AI
  aiConversations            AIConversation[]
  aiRequestLogs              AIRequestLog[]
  // Phase 18 — AI Agents
  aiAgentsCreated            AIAgent[]       @relation("AgentCreator")
  aiAgentPublishedVersions   AIAgentVersion[]
  aiAgentTasks               AIAgentTask[]

  @@unique([email])
  @@index([email])
  @@index([status])
  @@map("users")
}

/// Role defines a set of permissions. Roles can be system-level or tenant-scoped.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid  // null = system-level role (Super Admin)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false)  // system roles cannot be deleted
  isDefault   Boolean   @default(false)  // assigned automatically to new users
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Permission represents a single granular access right.
/// Permissions are platform-level (shared across tenants).
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)  // e.g., "employee:read", "payroll:approve"
  description String?   @db.VarChar(500)
  resource    String    @db.VarChar(100)  // e.g., "employee", "payroll", "finance"
  action      String    @db.VarChar(50)   // e.g., "read", "create", "update", "delete", "approve"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@index([resource])
  @@index([resource, action])
  @@map("permissions")
}

/// RolePermission is the many-to-many join between Role and Permission.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// UserRole assigns a role to a user within a specific tenant.
/// The scope field allows dimension-based access (branch, department, team).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  tenantId  String   @db.Uuid
  scope     Json?    // Optional: { branchId, departmentId, teamId } for scoped access
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// =============================================================================
// EMPLOYEE — THE CENTRAL BUSINESS ENTITY
// =============================================================================
// Employee is the spine of FusionOS. Every people-domain module
// (Attendance, Leave, Payroll, Assets, Projects) references this entity.
// There is ONE canonical Employee record — never duplicated across modules.

/// Designation represents a job title / position within the organization.
model Designation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  companyId   String    @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  level       Int?      // Hierarchy level (1 = entry, higher = senior)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  employees Employee[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@map("designations")
}

/// Employee is the central master entity of FusionOS.
/// Every module references the Employee rather than duplicating employee data.
model Employee {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  companyId         String          @db.Uuid
  userId            String?         @db.Uuid  // Linked auth user (nullable for future onboarding)
  employeeCode      String          @db.VarChar(50)  // Tenant-scoped business identifier
  firstName         String          @db.VarChar(255)
  middleName        String?         @db.VarChar(255)
  lastName          String          @db.VarChar(255)
  preferredName     String?         @db.VarChar(255)
  email             String          @db.VarChar(255)
  phone             String?         @db.VarChar(50)
  dateOfBirth       DateTime?       @db.Date
  gender            Gender?
  maritalStatus     MaritalStatus?
  nationality       String?         @db.VarChar(100)
  address           Json?           // Structured: { line1, line2, city, state, postalCode, country }

  // Employment
  branchId          String?         @db.Uuid
  departmentId      String?         @db.Uuid
  teamId            String?         @db.Uuid
  designationId     String?         @db.Uuid
  managerId         String?         @db.Uuid  // Self-referential: reports-to
  employmentStatus  EmploymentStatus @default(ACTIVE)
  employmentType    EmploymentType? @default(FULL_TIME)
  workLocation      String?         @db.VarChar(255)
  joiningDate       DateTime        @db.Date
  probationEndDate  DateTime?       @db.Date
  confirmationDate  DateTime?       @db.Date
  terminationDate   DateTime?       @db.Date

  // Salary Foundation (detailed payroll in Phase 9)
  currency          String?         @db.VarChar(3)  // ISO 4217
  basicSalary       Int?            // Integer minor units (e.g., cents). NULL = not yet configured.

  // Emergency Contact
  emergencyContactName     String? @db.VarChar(255)
  emergencyContactPhone    String? @db.VarChar(50)
  emergencyContactRelation String? @db.VarChar(100)

  // Additional
  timezone          String?         @db.VarChar(100)
  notes             String?         @db.Text

  // Metadata
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?       // Soft deletion — employee records are never hard-deleted

  // Relations
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch            Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department        Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team              Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  designation       Designation?    @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager           Employee?       @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports     Employee[]      @relation("EmployeeHierarchy")
  employmentHistory EmployeeHistory[]
  attendanceEvents  AttendanceEvent[]
  attendance        Attendance[]
  attendanceCorrections AttendanceCorrection[]
  leavePolicyAssignments LeavePolicyAssignment[]
  leaveBalances         LeaveBalance[]
  leaveBalanceTransactions LeaveBalanceTransaction[]
  leaveRequests            LeaveRequest[]
  salaryStructures         SalaryStructure[]
  payrollLines             PayrollLine[]
  payrollAdjustments       PayrollAdjustment[]
  payslips                 Payslip[]
  // Phase 9 — Finance
  journalLines             JournalLine[]
  expenses                 Expense[]
  // Phase 10 — CRM
  crmCustomerProfiles      CustomerProfile[]
  crmLeadsOwned            Lead[]
  crmLeadsConverted        Lead[]        @relation("LeadConvertedBy")
  crmOpportunitiesOwned    Opportunity[]
  crmActivities            Activity[]
  crmTasksAssigned         Task[]
  crmNotes                 CrmNote[]
  // Phase 11 — Projects
  managedProjects          Project[]       @relation("ProjectManager")
  createdProjects          Project[]       @relation("ProjectCreator")
  projectMemberships       ProjectMember[]
  projectTasksReported     ProjectTask[]   @relation("TaskReporter")
  projectTimeEntries       ProjectTimeEntry[]
  projectActivities        ProjectActivity[]
  // Phase 12 — Documents
  ownedDocuments           Document[]      @relation("DocumentOwner")
  createdDocuments         Document[]      @relation("DocumentCreator")
  documentVersions         DocumentVersion[]
  documentActivities       DocumentActivity[]
  // Phase 14 — Assets
  assetAssignments         AssetAssignment[]
  fromTransfers            AssetTransfer[]  @relation("TransferFromEmployee")
  toTransfers              AssetTransfer[]  @relation("TransferToEmployee")
  assetInspections         AssetInspection[]
  assetMaintenanceRecords  AssetMaintenanceRecord[]
  assetActivities          AssetActivity[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([teamId])
  @@index([designationId])
  @@index([managerId])
  @@index([userId])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, joiningDate])
  @@map("employees")
}

/// EmployeeHistory tracks employment changes over time.
/// This is an append-only record — never updated, only inserted.
model EmployeeHistory {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  employeeId    String          @db.Uuid
  action        String          @db.VarChar(50)  // e.g., "hired", "promoted", "transferred", "terminated"
  effectiveDate DateTime        @db.Date
  companyId     String?         @db.Uuid
  branchId      String?         @db.Uuid
  departmentId  String?         @db.Uuid
  teamId        String?         @db.Uuid
  designationId String?         @db.Uuid
  managerId     String?         @db.Uuid
  employmentStatus EmploymentStatus?
  previousValue    Json?  // Snapshot of changed fields before the event
  newValue         Json?  // Snapshot of changed fields after the event
  actorId          String? @db.Uuid  // User who made the change
  reason        String?         @db.VarChar(500)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([employeeId, effectiveDate])
  @@map("employee_history")
}

// =============================================================================
// EVENT OUTBOX — Foundation for Phase 17
// =============================================================================
// The outbox pattern ensures transactional consistency between business writes
// and event publication. Events are written in the same transaction as the
// business change, then dispatched asynchronously.
//
// Phase 17 will implement the dispatcher. This table provides the durable
// persistence foundation.

/// EventOutbox stores domain events for reliable, transactional event publication.
model EventOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  eventType     String    @db.VarChar(255)  // e.g., "employee.created", "attendance.recorded"
  aggregateType String    @db.VarChar(100)  // e.g., "employee", "attendance"
  aggregateId   String    @db.Uuid         // ID of the entity this event relates to
  payload       Json                     // Event data
  metadata      Json?                    // Correlation ID, causation ID, etc.
  status        String    @default("PENDING") @db.VarChar(20)  // PENDING, DISPATCHED, FAILED
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@index([status, createdAt])  // For polling pending events
  @@map("event_outbox")
}

// =============================================================================
// AUTHENTICATION — Phase 3
// =============================================================================
// These models support the authentication system: sessions, verification,
// password reset, and security event logging.

/// Session represents an authenticated user session.
/// Sessions are invalidated on logout and can be revoked by the user.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  token         String    @unique @db.VarChar(500)  // Opaque session identifier
  refreshToken  String    @unique @db.VarChar(500)  // Refresh token hash
  expiresAt     DateTime  // When the session expires
  lastUsedAt    DateTime?
  ipAddress     String?   @db.VarChar(45)  // IPv4 or IPv6
  userAgent     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

/// VerificationToken for email verification.
/// Single-use, short-lived tokens for verifying user email addresses.
model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(500)  // Hashed token — never stored plaintext
  type      String   @db.VarChar(50)  // "email_verification" or "password_reset"
  expiresAt DateTime // Token expiration
  usedAt    DateTime? // When the token was consumed (null = unused)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([type, userId])
  @@map("verification_tokens")
}

/// PasswordResetToken for secure password reset flow.
/// Single-use, short-lived tokens with hashed storage.
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(500)  // Hashed token — never stored plaintext
  expiresAt DateTime // Token expiration (short-lived: 1 hour)
  usedAt    DateTime? // When the token was consumed (null = unused)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

/// AuthEvent logs security-relevant authentication events.
/// Append-only — never updated or deleted.
model AuthEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid  // null for events on unknown emails (enumeration protection)
  eventType   String   @db.VarChar(50)  // login_success, login_failure, logout, password_reset, etc.
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  metadata    Json?    // Additional context (e.g., MFA method, failure reason)
  createdAt   DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("auth_events")
}

// =============================================================================
// ATTENDANCE — Phase 6
// =============================================================================
// Raw events preserve evidence. Calculated results are derived deterministically.
// Attendance records become the source of truth for future Leave and Payroll.

/// AttendanceEvent captures raw clock-in, clock-out, break events.
/// These are immutable evidence — never overwritten, only corrected by new events.
model AttendanceEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  employeeId    String                 @db.Uuid
  eventType     AttendanceEventType
  eventTime     DateTime               // When the event occurred (in employee timezone)
  source        AttendanceEventSource  @default(WEB)
  sourceRef     String?                @db.VarChar(255) // Device/session/reference ID
  idempotencyKey String?               @db.VarChar(255) // Prevent duplicate events
  notes         String?                @db.Text
  actorId       String?                @db.Uuid         // User who performed the action
  metadata      Json?                  // Additional context (ip, device, etc.)
  createdAt     DateTime               @default(now())

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([employeeId])
  @@index([employeeId, eventTime])
  @@index([tenantId, eventTime])
  @@index([idempotencyKey])
  @@map("attendance_events")
}

/// Attendance is the calculated daily attendance record.
/// Derived deterministically from valid AttendanceEvents.
/// This becomes the source of truth for Payroll (Phase 8).
model Attendance {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  employeeId            String                @db.Uuid
  date                  DateTime              @db.Date // The attendance date (in employee timezone)
  status                AttendanceStatus      @default(INCOMPLETE)
  recordStatus          AttendanceRecordStatus @default(DRAFT)

  // Calculated times (integer minutes — never floats)
  firstClockIn          DateTime?             // First clock-in of the day
  lastClockOut          DateTime?             // Last clock-out of the day
  totalWorkedMinutes    Int                   @default(0) // Total worked minutes
  totalBreakMinutes     Int                   @default(0) // Total break minutes
  lateMinutes           Int                   @default(0) // Minutes late
  earlyDepartureMinutes Int                   @default(0) // Minutes early departure
  overtimeMinutes       Int                   @default(0) // Overtime minutes

  source                AttendanceEventSource @default(WEB)
  notes                 String?               @db.Text
  calculatedAt          DateTime?             // When the calculation was performed
  confirmedAt           DateTime?             // When confirmed by HR/manager
  lockedAt              DateTime?             // When locked for payroll
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections AttendanceCorrection[]

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, date])
  @@index([employeeId, date])
  @@index([tenantId, status])
  @@index([tenantId, recordStatus])
  @@map("attendance")
}

/// AttendanceCorrection tracks authorized corrections to attendance.
/// Original events are preserved; corrections create new events and recalculate.
model AttendanceCorrection {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  attendanceId  String           @db.Uuid
  employeeId    String           @db.Uuid
  requestedBy   String           @db.Uuid // userId who requested
  status        CorrectionStatus @default(PENDING)
  correctionType String          @db.VarChar(50) // e.g., "clock_in_adjustment", "clock_out_add"
  originalValue Json?            // What the value was
  newValue      Json?            // What it should be
  reason        String           @db.VarChar(500)
  reviewedBy    String?          @db.Uuid // userId who approved/rejected
  reviewedAt    DateTime?
  reviewNotes   String?          @db.VarChar(500)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([attendanceId])
  @@index([employeeId])
  @@index([status])
  @@map("attendance_corrections")
}

// =============================================================================
// LEAVE MANAGEMENT — Phase 7
// =============================================================================
// Leave types, policies, balances, requests, and holidays.
// Integrates with Attendance (Phase 6) and provides contract for Payroll (Phase 8).

enum LeaveTypeStatus {
  ACTIVE
  INACTIVE
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveRequestUnit {
  FULL_DAY
  HALF_DAY
  HOURS
}

enum LeaveBalanceTransactionType {
  OPENING
  ACCRUAL
  CONSUMPTION
  REVERSAL
  CARRY_FORWARD
  ADJUSTMENT
  EXPIRY
}

enum AccrualFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

/// LeaveType defines a category of leave (Annual, Sick, Casual, etc.)
model LeaveType {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  companyId         String?          @db.Uuid
  name              String           @db.VarChar(100)
  code              String           @db.VarChar(20)
  description       String?          @db.VarChar(500)
  isPaid            Boolean          @default(true)
  status            LeaveTypeStatus  @default(ACTIVE)
  requiresApproval  Boolean          @default(true)
  requiresDocument  Boolean          @default(false)
  allowHalfDay      Boolean          @default(true)
  allowHourly       Boolean          @default(false)
  maxAccrualDays    Int?             // Max days that can accrue per year
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  policies          LeavePolicy[]
  balances          LeaveBalance[]
  requests          LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([companyId])
  @@map("leave_types")
}

/// LeavePolicy defines entitlement rules for a leave type
model LeavePolicy {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @db.Uuid
  companyId            String?           @db.Uuid
  name                 String            @db.VarChar(100)
  leaveTypeId          String            @db.Uuid
  entitlementDays      Int               @default(0) // Annual entitlement in days
  accrualFrequency     AccrualFrequency  @default(YEARLY)
  accrualAmount        Int               @default(0) // Days per accrual period
  carryForward         Boolean           @default(false)
  carryForwardLimit    Int?              // Max days that can carry forward
  minNoticeDays        Int               @default(0) // Minimum notice required
  maxConsecutiveDays   Int?              // Max consecutive days allowed
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  leaveType           LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  assignments         LeavePolicyAssignment[]
  balances            LeaveBalance[]

  @@unique([tenantId, leaveTypeId, name])
  @@index([tenantId])
  @@index([leaveTypeId])
  @@map("leave_policies")
}

/// LeavePolicyAssignment assigns a policy to an employee (or group)
model LeavePolicyAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  policyId       String   @db.Uuid
  employeeId     String   @db.Uuid
  effectiveFrom  DateTime @db.Date
  effectiveTo    DateTime? @db.Date
  createdAt      DateTime @default(now())

  // Relations
  policy         LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([policyId])
  @@map("leave_policy_assignments")
}

/// LeaveBalance tracks an employee's balance for a leave type in a period
model LeaveBalance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  employeeId     String   @db.Uuid
  leaveTypeId    String   @db.Uuid
  policyId       String?  @db.Uuid
  year           Int      // Calendar year (e.g., 2026)
  opening        Int      @default(0) // Opening balance from previous year
  accrued        Int      @default(0) // Total accrued this period
  used           Int      @default(0) // Total consumed (approved requests)
  pending        Int      @default(0) // Reserved by pending requests
  adjustments    Int      @default(0) // Manual adjustments (+/-)
  carryForward   Int      @default(0) // Carried forward from previous year
  remaining      Int      @default(0) // Computed: opening + accrued + carryForward + adjustments - used
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  policy         LeavePolicy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  transactions   LeaveBalanceTransaction[]

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([employeeId, year])
  @@map("leave_balances")
}

/// LeaveBalanceTransaction is the immutable ledger for balance changes
model LeaveBalanceTransaction {
  id              String                       @id @default(uuid()) @db.Uuid
  tenantId        String                       @db.Uuid
  balanceId       String                       @db.Uuid
  employeeId      String                       @db.Uuid
  transactionType LeaveBalanceTransactionType
  amount          Int                          // Positive = credit, negative = debit
  referenceId     String?                      @db.Uuid // e.g., leaveRequestId
  referenceType   String?                      @db.VarChar(50) // e.g., "LeaveRequest"
  reason          String?                      @db.VarChar(500)
  actorId         String?                      @db.Uuid
  createdAt       DateTime                     @default(now())

  // Relations
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  balance         LeaveBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([balanceId])
  @@index([employeeId])
  @@index([referenceId])
  @@map("leave_balance_transactions")
}

/// LeaveRequest is an employee's request for time off
model LeaveRequest {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  employeeId     String              @db.Uuid
  leaveTypeId    String              @db.Uuid
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  duration       Int                 @default(0) // Calculated by backend (integer days)
  unit           LeaveRequestUnit    @default(FULL_DAY)
  reason         String?             @db.VarChar(1000)
  attachmentUrl  String?             @db.VarChar(500)
  status         LeaveRequestStatus  @default(DRAFT)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?             @db.Uuid
  rejectionReason String?            @db.VarChar(500)
  cancelledAt    DateTime?
  cancelledBy    String?             @db.Uuid
  cancellationReason String?         @db.VarChar(500)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([tenantId, status])
  @@index([employeeId, startDate])
  @@map("leave_requests")
}

/// Holiday represents a company/tenant-wide non-working day
model Holiday {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  companyId   String?   @db.Uuid
  branchId    String?   @db.Uuid
  name        String    @db.VarChar(100)
  date        DateTime  @db.Date
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, date, name])
  @@index([tenantId])
  @@index([companyId])
  @@index([date])
  @@map("holidays")
}

/// WorkingCalendar defines which days are working days for a tenant/company
model WorkingCalendar {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  companyId   String?   @db.Uuid
  name        String    @db.VarChar(100)
  weekendDays String    @default("SATURDAY,SUNDAY") @db.VarChar(100) // Comma-separated DayOfWeek
  timezone    String    @default("UTC") @db.VarChar(100)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("working_calendars")
}

// =============================================================================
// PAYROLL MANAGEMENT — Phase 8
// =============================================================================
// Payroll engine supporting attendance-based, manual, and hybrid calculation.
// All monetary amounts use INTEGER minor units (consistent with Phase 1 strategy).
// Calculation snapshots are preserved for auditability.
// Finalized payroll is immutable.

enum PayrollPeriodStatus {
  DRAFT
  OPEN
  PROCESSING
  CALCULATED
  UNDER_REVIEW
  APPROVED
  FINALIZED
  CLOSED
}

enum PayrollRunStatus {
  PENDING
  CALCULATING
  CALCULATED
  REVIEWING
  REVIEWED
  APPROVED
  FINALIZED
  FAILED
}

enum PayrollCalculationMode {
  ATTENDANCE
  MANUAL
  HYBRID
}

enum PayrollComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  REIMBURSEMENT
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  DAILY
}

enum PayrollLineStatus {
  DRAFT
  CALCULATED
  REVIEWED
  ADJUSTED
  FINALIZED
  CORRECTED
}

enum PayrollAdjustmentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PayslipStatus {
  GENERATED
  FINALIZED
  CORRECTED
}

/// PayrollPolicy defines configurable rules for payroll calculation within a tenant.
model PayrollPolicy {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  name                String         @db.VarChar(100)
  companyId           String?        @db.Uuid
  workingDaysPerWeek  Int            @default(5)
  workingDaysPerMonth Int            @default(22) // Standard divisor for monthly salary
  payFrequency        PayFrequency   @default(MONTHLY)
  defaultCalcMode     PayrollCalculationMode @default(ATTENDANCE)
  overtimeEnabled     Boolean        @default(true)
  overtimeMultiplier  Int            @default(150) // Percentage: 150 = 1.5x
  overtimeCapMinutes  Int?           // Max overtime per day in minutes
  absenceDeduct       Boolean        @default(true)
  absenceDivisor      Int            @default(22) // Days to divide monthly salary for per-day rate
  roundingPrecision   Int            @default(2)  // Decimal places for final amounts
  roundingMode        String         @default("HALF_UP") @db.VarChar(20) // HALF_UP, HALF_DOWN, CEIL, FLOOR
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("payroll_policies")
}

/// PayrollComponent defines configurable earning/deduction types.
model PayrollComponent {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  companyId     String?              @db.Uuid
  name          String               @db.VarChar(100)
  code          String               @db.VarChar(30)
  type          PayrollComponentType
  isStatutory   Boolean              @default(false)
  isFixed       Boolean              @default(true) // true = fixed amount, false = calculated
  defaultValue  Int?                 // Default amount in minor units
  calculationBasis String?           @db.VarChar(50) // e.g., "basic_salary", "gross_pay"
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  salaryStructureComponents SalaryStructureComponent[]
  lineItems                 PayrollLineItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("payroll_components")
}

/// SalaryStructure defines an employee's compensation with effective dates.
model SalaryStructure {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  employeeId     String       @db.Uuid
  companyId      String?      @db.Uuid
  currency       String       @default("USD") @db.VarChar(3) // ISO 4217
  payFrequency   PayFrequency @default(MONTHLY)
  basicSalary    Int          // Integer minor units — never floats
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  isActive       Boolean      @default(true)
  status         String       @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, SUPERSEDED
  notes          String?      @db.Text
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employee  Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components SalaryStructureComponent[]
  lines     PayrollLine[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([employeeId, effectiveFrom])
  @@index([tenantId, isActive])
  @@index([employeeId, isActive])
  @@map("salary_structures")
}

/// SalaryStructureComponent stores individual salary components for a structure.
model SalaryStructureComponent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  salaryStructureId String  @db.Uuid
  componentId      String   @db.Uuid
  amount           Int      // Integer minor units
  createdAt        DateTime @default(now())

  salaryStructure SalaryStructure  @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  component       PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, componentId])
  @@index([tenantId])
  @@index([salaryStructureId])
  @@index([componentId])
  @@map("salary_structure_components")
}

/// PayrollPeriod represents a payroll time period (e.g., January 2026).
model PayrollPeriod {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  companyId     String?            @db.Uuid
  name          String             @db.VarChar(100)
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  paymentDate   DateTime           @db.Date
  status        PayrollPeriodStatus @default(DRAFT)
  createdBy     String?            @db.Uuid
  approvedBy    String?            @db.Uuid
calculatedAt  DateTime?
  finalizedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   PayrollRun[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@map("payroll_periods")
}

/// PayrollRun represents a single payroll execution for a period.
model PayrollRun {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  periodId         String              @db.Uuid
  companyId        String?             @db.Uuid
  calculationMode  PayrollCalculationMode @default(ATTENDANCE)
  status           PayrollRunStatus    @default(PENDING)
  employeeScope    String?             @db.VarChar(50) // "all" or specific filter
  calculatedAt     DateTime?
  reviewedAt       DateTime?
  approvedBy       String?             @db.Uuid
  approvedAt       DateTime?
  finalizedAt      DateTime?
  createdBy        String?             @db.Uuid
  totalEmployees   Int                 @default(0)
  totalGross       Int                 @default(0) // Integer minor units
  totalDeductions  Int                 @default(0)
  totalNet         Int                 @default(0)
  currency         String              @default("USD") @db.VarChar(3)
  errorCount       Int                 @default(0)
  warningCount     Int                 @default(0)
  errors           Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  PayrollLine[]

  @@unique([tenantId, periodId, calculationMode])
  @@index([tenantId])
  @@index([periodId])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

/// PayrollLine represents one employee's calculated payroll for a run.
/// This is the immutable calculation snapshot.
model PayrollLine {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  runId             String           @db.Uuid
  employeeId        String           @db.Uuid
  salaryStructureId String?          @db.Uuid
  currency          String           @default("USD") @db.VarChar(3)
  calculationMode   PayrollCalculationMode @default(ATTENDANCE)
  status            PayrollLineStatus @default(DRAFT)
  workingDays       Int              @default(0) // Days in period
  workedDays        Int              @default(0) // Days actually worked
  absentDays        Int              @default(0)
  paidLeaveDays     Int              @default(0)
  unpaidLeaveDays   Int              @default(0)
  overtimeMinutes   Int              @default(0)
  grossPay          Int              @default(0) // Integer minor units
  totalDeductions   Int              @default(0)
  totalEarnings     Int              @default(0)
  netPay            Int              @default(0)
  calculatedAt      DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  run             PayrollRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure?  @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  items           PayrollLineItem[]
  adjustments     PayrollAdjustment[]
  payslip         Payslip?

  @@unique([runId, employeeId])
  @@index([tenantId])
  @@index([runId])
  @@index([employeeId])
  @@index([tenantId, employeeId])
  @@index([runId, status])
  @@map("payroll_lines")
}

/// PayrollLineItem stores individual earning/deduction items for a payroll line.
model PayrollLineItem {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  lineId        String               @db.Uuid
  componentId   String?              @db.Uuid
  type          PayrollComponentType
  code          String               @db.VarChar(30)
  name          String               @db.VarChar(100)
  amount        Int                  // Integer minor units (positive for earnings, positive for deductions)
  source        String               @default("SYSTEM") @db.VarChar(20) // SYSTEM, MANUAL, ADJUSTMENT
  calculationBasis String?           @db.VarChar(100) // Description of how it was calculated
  referenceId   String?              @db.Uuid // e.g., adjustmentId
  createdAt     DateTime             @default(now())

  line      PayrollLine       @relation(fields: [lineId], references: [id], onDelete: Cascade)
  component PayrollComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([lineId])
  @@index([componentId])
  @@index([lineId, type])
  @@map("payroll_line_items")
}

/// PayrollAdjustment represents manual adjustments to a payroll line.
model PayrollAdjustment {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  lineId        String                 @db.Uuid
  employeeId    String                 @db.Uuid
  type          PayrollComponentType   // EARNING or DEDUCTION
  code          String                 @db.VarChar(30)
  name          String                 @db.VarChar(100)
  amount        Int                    // Integer minor units
  reason        String                 @db.VarChar(500)
  status        PayrollAdjustmentStatus @default(PENDING)
  approvedBy    String?                @db.Uuid
  approvedAt    DateTime?
  rejectionReason String?              @db.VarChar(500)
  createdBy     String?                @db.Uuid
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  line     PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([lineId])
  @@index([employeeId])
  @@index([tenantId, status])
  @@map("payroll_adjustments")
}

/// Payslip is the final snapshot generated after payroll finalization.
model Payslip {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  lineId        String         @unique @db.Uuid
  employeeId    String         @db.Uuid
  periodId      String         @db.Uuid
  runId         String         @db.Uuid
  currency      String         @default("USD") @db.VarChar(3)
  grossPay      Int            @default(0) // Integer minor units
  totalEarnings Int            @default(0)
  totalDeductions Int          @default(0)
  netPay        Int            @default(0)
  paymentDate   DateTime       @db.Date
  status        PayslipStatus  @default(GENERATED)
  generatedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  line     PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, periodId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([periodId])
  @@index([runId])
  @@map("payslips")
}

// =============================================================================
// AUDIT & EVENTS — Append-only business audit log and event outbox
// =============================================================================

/// AuditLog is an append-only business audit trail.
/// Records important mutations for investigation and compliance.
/// Never stores passwords, tokens, or secrets.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorId     String?  @db.Uuid // User who performed the action
  action      String   @db.VarChar(100) // e.g. EMPLOYEE_CREATED, PAYROLL_APPROVED
  entityType  String   @db.VarChar(100) // e.g. Employee, PayrollRun
  entityId    String?  @db.Uuid
  previousValue Json?  // Snapshot of previous state (where applicable)
  newValue      Json?  // Snapshot of new state (where applicable)
  metadata    Json?    // Additional context (requestId, IP, etc.)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([tenantId, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PHASE 13 — ENTERPRISE NOTIFICATIONS & COMMUNICATION INFRASTRUCTURE
// =============================================================================
// Centralized notification engine. Extends the existing FusionOS EventOutbox
// pattern with notification processing, delivery tracking, templates, and
// user preferences.
// =============================================================================

/// Notification represents a business notification generated for a specific recipient.
model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  recipientUserId String               @db.Uuid
  type            String               @db.VarChar(100)
  title           String               @db.VarChar(500)
  body            String               @db.Text
  severity        NotificationSeverity @default(INFO)
  category        String               @db.VarChar(50)
  entityType      String?              @db.VarChar(50)
  entityId        String?              @db.Uuid
  actionUrl       String?              @db.VarChar(500)
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User                   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([tenantId, recipientUserId, type, entityId])
  @@index([tenantId])
  @@index([recipientUserId])
  @@index([tenantId, recipientUserId])
  @@index([tenantId, recipientUserId, readAt])
  @@index([tenantId, recipientUserId, createdAt])
  @@index([tenantId, type])
  @@index([tenantId, category])
  @@index([tenantId, severity])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("notifications")
}

/// NotificationDelivery tracks each delivery attempt for a notification.
model NotificationDelivery {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @db.Uuid
  notificationId    String                   @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  provider          String?                  @db.VarChar(50)
  providerMessageId String?                  @db.VarChar(255)
  attemptCount      Int                      @default(0)
  maxAttempts       Int                      @default(3)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?                  @db.Text
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([tenantId])
  @@index([notificationId])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

/// NotificationPreference stores per-user, per-type, per-channel preferences.
model NotificationPreference {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  userId           String              @db.Uuid
  notificationType String              @db.VarChar(100)
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  isMandatory      Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, notificationType, channel])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

/// NotificationTemplate defines data-driven templates for notification rendering.
model NotificationTemplate {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @db.Uuid
  name             String                   @db.VarChar(200)
  notificationType String                   @db.VarChar(100)
  channel          NotificationChannel
  subject          String?                  @db.VarChar(500)
  body             String                   @db.Text
  variables        Json?
  status           NotificationTemplateStatus @default(DRAFT)
  version          Int                      @default(1)
  isSystemDefault  Boolean                  @default(false)
  createdBy        String?                  @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  User?                      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  versions NotificationTemplateVersion[]

  @@unique([tenantId, notificationType, channel, version])
  @@index([tenantId])
  @@index([tenantId, notificationType])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@map("notification_templates")
}

/// NotificationTemplateVersion stores immutable historical snapshots.
model NotificationTemplateVersion {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  templateId String   @db.Uuid
  version    Int
  name       String   @db.VarChar(200)
  subject    String?  @db.VarChar(500)
  body       String   @db.Text
  variables  Json?
  changedBy  String?  @db.Uuid
  createdAt  DateTime @default(now())

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  changer  User?                @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@index([tenantId])
  @@index([templateId])
  @@map("notification_template_versions")
}

/// NotificationChannelConfiguration stores per-tenant channel settings.
model NotificationChannelConfiguration {
  id        String                         @id @default(uuid()) @db.Uuid
  tenantId  String                         @db.Uuid
  channel   NotificationChannel
  provider  String                         @db.VarChar(50)
  config    Json
  status    NotificationChannelConfigStatus @default(ACTIVE)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId])
  @@map("notification_channel_configs")
}

// =============================================================================
// PHASE 14 — ENTERPRISE ASSET & EQUIPMENT MANAGEMENT
// =============================================================================
// Canonical asset entity with lifecycle, assignment, maintenance,
// inspection, warranty, depreciation, and disposal management.
// =============================================================================

/// AssetCategory defines classification of assets (IT, Furniture, Vehicle, etc.)
model AssetCategory {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  companyId       String            @db.Uuid
  name            String            @db.VarChar(255)
  code            String            @db.VarChar(50)
  description     String?           @db.VarChar(500)
  categoryType    AssetCategoryType @default(OTHER)
  defaultUsefulLife Int?            // Default useful life in months
  defaultDepreciationMethod AssetDepreciationMethod? @default(STRAIGHT_LINE)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([categoryType])
  @@map("asset_categories")
}

/// AssetLocation represents a physical/logical location for assets
model AssetLocation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  companyId   String    @db.Uuid
  branchId    String?   @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  building    String?   @db.VarChar(255)
  floor       String?   @db.VarChar(100)
  room        String?   @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assets   Asset[]
  fromTransfers AssetTransfer[] @relation("TransferFromLocation")
  toTransfers   AssetTransfer[] @relation("TransferToLocation")

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@map("asset_locations")
}

/// Asset is the canonical entity for asset & equipment management
model Asset {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  companyId           String                @db.Uuid
  categoryId          String?               @db.Uuid
  locationId          String?               @db.Uuid
  assetCode           String                @db.VarChar(50)
  name                String                @db.VarChar(255)
  description         String?               @db.Text
  serialNumber        String?               @db.VarChar(255)
  manufacturer        String?               @db.VarChar(255)
  model               String?               @db.VarChar(255)
  purchaseDate        DateTime?             @db.Date
  purchaseCost        Int                   @default(0) // Integer minor units
  currency            String                @default("USD") @db.VarChar(3)
  status              AssetStatus           @default(DRAFT)
  condition           AssetCondition        @default(NEW)
  currentBookValue    Int                   @default(0) // Integer minor units
  usefulLife          Int?                  // Useful life in months
  residualValue       Int                   @default(0) // Integer minor units
  inServiceDate       DateTime?             @db.Date
  disposalDate        DateTime?             @db.Date
  disposalMethod      AssetDisposalMethod?
  disposalReason      String?               @db.VarChar(500)
  disposalProceeds    Int                   @default(0) // Integer minor units
  vendorId            String?               @db.Uuid
  notes               String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   AssetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location   AssetLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vendor     Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]
  transfers  AssetTransfer[]
  maintenanceRecords AssetMaintenanceRecord[]
  inspections AssetInspection[]
  warranties  AssetWarranty[]
  activities  AssetActivity[]
  depreciations AssetDepreciation[]

  @@unique([tenantId, companyId, assetCode])
  @@index([tenantId])
  @@index([companyId])
  @@index([categoryId])
  @@index([locationId])
  @@index([vendorId])
  @@index([status])
  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, categoryId])
  @@map("assets")
}

/// AssetAssignment tracks employee and project assignments for assets
model AssetAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  assetId       String    @db.Uuid
  employeeId    String?   @db.Uuid
  projectId     String?   @db.Uuid
  assignedAt    DateTime  @default(now())
  returnedAt    DateTime?
  status        String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, RETURNED, TRANSFERRED
  notes         String?   @db.VarChar(500)
  assignedBy    String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([assetId, employeeId, status])
  @@index([tenantId])
  @@index([assetId])
  @@index([employeeId])
  @@index([projectId])
  @@index([status])
  @@map("asset_assignments")
}

/// AssetTransfer tracks asset transfers between employees/branches/locations
model AssetTransfer {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  assetId           String    @db.Uuid
  fromEmployeeId    String?   @db.Uuid
  toEmployeeId      String?   @db.Uuid
  fromBranchId      String?   @db.Uuid
  toBranchId        String?   @db.Uuid
  fromLocationId    String?   @db.Uuid
  toLocationId      String?   @db.Uuid
  fromProjectId     String?   @db.Uuid
  toProjectId       String?   @db.Uuid
  transferDate      DateTime  @default(now())
  reason            String?   @db.VarChar(500)
  notes             String?   @db.Text
  transferredBy     String?   @db.Uuid
  createdAt         DateTime  @default(now())

  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromEmployee   Employee? @relation("TransferFromEmployee", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  toEmployee     Employee? @relation("TransferToEmployee", fields: [toEmployeeId], references: [id], onDelete: SetNull)
  fromBranch     Branch?   @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch       Branch?   @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  fromLocation   AssetLocation? @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     AssetLocation? @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  fromProject    Project?  @relation("TransferFromProject", fields: [fromProjectId], references: [id], onDelete: SetNull)
  toProject      Project?  @relation("TransferToProject", fields: [toProjectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([assetId])
  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([transferDate])
  @@map("asset_transfers")
}

/// AssetMaintenanceRecord tracks maintenance activities for assets
model AssetMaintenanceRecord {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  assetId         String                  @db.Uuid
  type            AssetMaintenanceType
  title           String                  @db.VarChar(255)
  description     String?                 @db.Text
  priority        String                  @default("MEDIUM") @db.VarChar(20) // LOW, MEDIUM, HIGH, URGENT
  scheduledDate   DateTime?               @db.Date
  startedAt       DateTime?
  completedAt     DateTime?
  status          AssetMaintenanceStatus  @default(SCHEDULED)
  vendor          String?                 @db.VarChar(255)
  cost            Int                     @default(0) // Integer minor units
  currency        String                  @default("USD") @db.VarChar(3)
  notes           String?                 @db.Text
  assignedToId    String?                 @db.Uuid
  createdBy       String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([assetId])
  @@index([status])
  @@index([scheduledDate])
  @@index([tenantId, assetId])
  @@map("asset_maintenance_records")
}

/// AssetInspection tracks inspection activities for assets
model AssetInspection {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  assetId         String                @db.Uuid
  inspectionType  String                @db.VarChar(100)
  scheduledDate   DateTime              @db.Date
  completedDate   DateTime?
  inspectorId     String?   @db.Uuid
